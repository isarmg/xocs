+/// Hash each physical path once within a single snapshot. A fresh cache is
+/// created for every snapshot; before/after checks always reread source bytes.
+#[derive(Default)]
+struct SnapshotFiles {
+    hashes: BTreeMap<PathBuf, String>,
+}
+
+impl SnapshotFiles {
+    fn read(&mut self, path: &Path) -> Result<Vec<u8>> {
+        let bytes = read(path)?;
+        self.hashes.insert(path.into(), sha(&bytes));
+        Ok(bytes)
+    }
+
+    fn hash(&mut self, path: &Path) -> Result<String> {
+        if let Some(digest) = self.hashes.get(path) {
+            return Ok(digest.clone());
+        }
+        self.read(path)?;
+        Ok(self.hashes[path].clone())
+    }
+
+    fn files(&mut self, root: &Path) -> Result<Files> {
+        walk(root)?
+            .into_iter()
+            .map(|path| Ok((relative(path.strip_prefix(root)?)?, self.hash(&path)?)))
+            .collect()
+    }
+}
