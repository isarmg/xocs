{
  "name": "xocs-web",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --test tests/*.test.mjs",
    "test:language": "npm run build && node tests/language.mjs",
    "test:admin": "npm run build && node tests/admin-layout.mjs && node tests/account-settings.mjs",
    "test:public": "npm run build && node tests/public-layout.mjs && node tests/anonymous-comments.mjs"
  },
  "dependencies": {
    "@xcss/web": "https://github.com/isarmg/xcss/releases/download/v1.0.2/xcss-web-1.0.2.tgz",
    "dompurify": "3.4.16",
    "markdown-it": "15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
