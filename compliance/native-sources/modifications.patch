-fn require_product_id(value: &str) -> Result<(), Error> {
-    let bytes = value.as_bytes();
-    if bytes.is_empty()
-        || bytes.len() > 63
-        || !bytes[0].is_ascii_lowercase()
-        || !bytes
-            .iter()
-            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || *byte == b'-')
-    {
-        return Err(Error::InvalidProductId);
-    }
-    Ok(())
-}
